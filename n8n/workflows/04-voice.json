      "id": "a7b7db19-2aac-5b7e-8505-2f650bfefa49",
      "name": "Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Groq key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Node \"Transcript\": turns the speech-to-text answer into { ok, text } or a short, speakable error.\nconst r = $input.first().json || {};\nconst body = r.body && typeof r.body === 'object' ? r.body : {};\nconst status = Number(r.statusCode);\n\nif (status >= 200 && status < 300 && typeof body.text === 'string') {\n  const text = body.text.trim();\n  // On near-silence, Whisper tends to invent a stock phrase. Treat those as \"nothing heard\".\n  const stock = /^(thank you\\.?|thanks\\.?|thanks for watching\\.?|you\\.?|bye\\.?|\\.+)$/i;\n  if (!text || stock.test(text)) {\n    return [{ json: { ok: false, error: 'empty', reply: \"I didn't catch anything. Try again.\" } }];\n  }\n  return [{ json: { ok: true, text } }];\n}\nif (status === 429) {\n  return [{ json: { ok: false, error: 'busy', reply: 'The voice service is busy. Try again in a minute.' } }];\n}\nconst detail = String(body.error && body.error.message ? body.error.message : (r.error || r.body || '')).slice(0, 200);\nreturn [{ json: { ok: false, error: 'stt_error', reply: \"I couldn't make that out. Try again.\", detail } }];\n"
      },
      "id": "c5bea979-16db-5489-93b5-85b405015a00",
      "name": "Transcript",
