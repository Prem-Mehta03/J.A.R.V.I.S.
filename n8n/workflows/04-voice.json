    {
      "parameters": {
        "jsCode": "// Node \"Check audio\": makes sure the request carried a recording, and gives the file a name Whisper recognises.\nconst item = $input.first();\nconst bin = item.binary && item.binary.audio;\nif (!bin) {\n  return [{ json: { ok: false, error: 'no_audio', reply: \"I didn't receive any audio. Try again.\" } }];\n}\nconst mime = String(bin.mimeType || '').toLowerCase();\nlet ext = 'm4a';\nif (mime.includes('webm')) ext = 'webm';\nelse if (mime.includes('ogg')) ext = 'ogg';\nelse if (mime.includes('wav')) ext = 'wav';\nelse if (mime.includes('mpeg') || mime.includes('mp3')) ext = 'mp3';\nbin.fileName = 'voice.' + ext;\nreturn [{ json: { ok: true, mime }, binary: { audio: bin } }];\n"
      },
      "id": "9c0ffef1-e4b1-51cc-a09f-df37ce17c315",
      "name": "Check audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
