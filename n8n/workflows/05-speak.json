      "id": "52e3ab8f-c80f-523f-8f09-f5ef50e4946d",
      "name": "Groq speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Groq key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Node \"Pack audio\": the text-to-speech answer arrives as a file. If it is audio, hand it back as base64 JSON;\n// otherwise it is an error message from Groq, so turn that into a short reason the app can show.\nconst item = $input.first();\nconst bin = item.binary && item.binary.data;\nif (!bin) return [{ json: { ok: false, error: 'tts_error', reply: 'No audio came back.' } }];\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (/^audio\\//i.test(String(bin.mimeType || '')) || buf.slice(0, 4).toString('latin1') === 'RIFF') {\n  return [{ json: { ok: true, audio: buf.toString('base64'), mime: 'audio/wav' } }];\n}\nlet detail = '';\ntry { const j = JSON.parse(buf.toString('utf8')); detail = String((j.error && (j.error.message || j.error.code)) || j.message || ''); } catch (e) { detail = buf.toString('utf8').slice(0, 160); }\ndetail = detail.slice(0, 200);\nlet error = 'tts_error';\nif (/terms/i.test(detail)) error = 'terms';\nelse if (/rate|limit|quota|exceeded/i.test(detail)) error = 'busy';\nreturn [{ json: { ok: false, error, reply: 'The natural voice is not available right now.', detail } }];\n"
      },
      "id": "d95c23ad-fe71-5b99-afd0-5a806afa6dc4",
