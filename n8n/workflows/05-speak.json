    {
      "parameters": {
        "jsCode": "// Node \"Check text\": validates the request and builds the Groq text-to-speech body.\nconst body = ($input.first().json || {}).body || {};\nconst VOICES = ['austin', 'troy', 'daniel', 'autumn', 'diana', 'hannah'];\nconst text = typeof body.text === 'string' ? body.text.replace(/\\s+/g, ' ').trim() : '';\nif (!text) return [{ json: { ok: false, error: 'missing_text', reply: 'There was nothing to say.' } }];\nif (text.length > 400) return [{ json: { ok: false, error: 'text_too_long', reply: 'That is too long to speak in one piece.' } }];\nconst voice = VOICES.includes(body.voice) ? body.voice : 'troy';\nreturn [{ json: { ok: true, tts_body: { model: 'canopylabs/orpheus-v1-english', input: text, voice, response_format: 'wav' } } }];\n"
      },
      "id": "e7c6e491-5c71-525d-9797-62d83138bbda",
      "name": "Check text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a9adf74b-abc8-5589-9443-0a0f1435d646",
              "leftValue": "={{ $json.ok === true }}",
