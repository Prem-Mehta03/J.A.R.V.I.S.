# Reference list of every secret and setting Jarvis needs.
# Do NOT put real values in this file. Real values live in:
#   - Render dashboard (n8n service environment), for the n8n and database settings
#   - n8n credentials (inside the n8n UI), for API keys, tokens and Gmail
#   - your own PC's shell session, for the export script (never saved to a file in the repo)

# --- n8n (set in Render) ---
N8N_ENCRYPTION_KEY=generated-by-render-keep-it-forever
N8N_HOST=YOUR-SERVICE.onrender.com
N8N_WEBHOOK_URL=https://YOUR-SERVICE.onrender.com/

# --- Supabase Postgres (set in Render) ---
# Use the Session pooler connection details from Supabase (works over IPv4).
DB_POSTGRESDB_HOST=aws-0-REGION.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.YOUR_PROJECT_REF
DB_POSTGRESDB_PASSWORD=your-database-password

# --- Jarvis (create inside n8n as credentials, one per item) ---
# "Jarvis token": Header Auth credential, header name X-Jarvis-Token. Also typed by hand into each Shortcut
# and entered once in the PWA (stored on the phone only). Generate with scripts/new-token.ps1.
JARVIS_WEBHOOK_TOKEN=64-hex-characters-from-new-token.ps1
# Header Auth credential, header name x-goog-api-key
GEMINI_API_KEY=from-google-ai-studio
# Header Auth credential, header name Authorization, value "Bearer <key>"
GROQ_API_KEY=from-console.groq.com
# Push alerts use Bark (M3.1). Its device key is saved in the database (jarvis.settings, key bark_key), not here,
# and never in a workflow file: the key behaves like a password.

# --- Local only: your PC, for scripts/export_n8n.py (set in the shell, never in a file) ---
# N8N_URL=https://YOUR-SERVICE.onrender.com
# N8N_API_KEY=created in n8n under Settings, n8n API
